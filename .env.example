# ========================================
# INSPIRE Colloquium Admin Panel
# Environment Variables
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or .env.local with real credentials.
# Generate AUTH_SECRET with: openssl rand -base64 48

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/inspire_colloquium

# --- Authentication ---
# A long random secret for session signing (min 32 chars)
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret

# Session max age in seconds (default: 8 hours)
SESSION_MAX_AGE_SECONDS=28800

# --- Login Rate Limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Initial Admin (used only by: npm run create-admin) ---
# These are NOT auto-created in production.
# Use the CLI: npm run create-admin -- --email admin@example.com
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=INSPIRE Colloquium <colloquium.ieee@slrtce.in>
SUPPORT_EMAIL=colloquium.ieee@slrtce.in

# --- File Storage ---
STORAGE_PROVIDER=local
# For S3-compatible storage:
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
